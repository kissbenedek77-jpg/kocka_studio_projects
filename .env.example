# A Google Cloud OAuth web client adatai. Az átirányítás: https://projects.kockastudio.hu/auth/callback
# A Railway-ben előbb igazold a saját domaint, csak utána állítsd át ezt az értéket.
BASE_URL=https://projects.kockastudio.hu
# Opcionális: a korábban elküldött Railway-űrlaplinkeket a saját domainre irányítja.
LEGACY_PUBLIC_ORIGIN=https://kockastudio-projects.up.railway.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcionális, ha van kulcsos szolgáltatásfiók; helyettesíthető a kulcs nélküli változóval.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Kulcs nélküli levélkövetéshez: a dashboard „Kulcs nélküli követés beállítása” gombja adja.
# A SESSION_SECRET és az OAuth-kliens adatai maradjanak változatlanok.
GOOGLE_TRACKING_CREDENTIAL=
OWNER_EMAIL=
SESSION_SECRET=
# Saját tulajdonosi belépés: a dashboard „Saját belépés” ablaka adja az értéket.
# Terminálos alternatíva: node scripts/create_local_password_hash.cjs
# A Google Drive/Sheets háttérhozzáféréshez és a nyilvános ajánlatkéréshez GOOGLE_TRACKING_CREDENTIAL is kell.
LOCAL_LOGIN_USERNAME=
LOCAL_LOGIN_PASSWORD_HASH=
SHEET_ID=1BqQ0F4QjWJQfpCB3zSOibKCZ41xk6GzW7V3W6gdNp7I
SHEET_NAME=Adatok
TEMPLATE_ROOT_FOLDER_ID=1yw8ts2OTQTK0y2dn8TnovvR5HbWSqHWd
# Opcionális: meglévő _Marketing Drive-mappa azonosítója. Üresen a _template mellett jön létre.
MARKETING_FOLDER_ID=
# A _Template melletti Drive _System mappa: ajanlat.html, szerzodes.html, adatbekeres.html, tervcsomag.html
SYSTEM_FOLDER_ID=1zmwwzmeZybDfT5xIsVgEpfp6LIHzRv0r
PROJECT_DATA_TEMPLATE_ID=1NZPw7bJAQFfQbTNl3yzObRly1bjyt2hRfQ0QHhCN4Dg
IMAP_HOST=mail.kockastudio.hu
IMAP_PORT=993
IMAP_SENT_FOLDER=
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=mail.kockastudio.hu
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Railway Free/Hobby: Resend HTTPS API. Az emailcím a Resendben hitelesített domainhez tartozzon.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Resend Webhooks / Signing secret; endpoint: BASE_URL/webhooks/resend, esemény: email.opened.
RESEND_WEBHOOK_SECRET=
EMAIL_PROVIDER=resend
# Opcionális tulajdonosi e-mail az első ügyfélbeküldéskor és hiányos→teljes váltáskor.
# Alapértelmezés: kikapcsolva; címzett: OWNER_EMAIL. A dashboard-jelzés ettől független.
CLIENT_SUBMISSION_EMAIL=0
GEMINI_API_KEY=
# Műszaki szövegek: a régi gemini-2.5-* modellek új projekteknél HTTP 404-et adnak.
# Bevált alapérték: gemini-3.5-flash-lite (a kód 404 esetén erre is visszaesik).
GEMINI_AUDIO_MODEL=gemini-3.5-flash-lite
GEMINI_TECHNICAL_MODEL=gemini-3.5-flash-lite
# Marketing AI-kreatívtervező: szövegmodell képbemenettel, szerveroldali napi 12 kérés/replica.
# A Képkészítés fül Gemini Image modellje is a GEMINI_API_KEY kulcsot használja; a fizetős kvótába számít.
GEMINI_MARKETING_MODEL=gemini-3.5-flash-lite
# Marketing AI-háttérkép a Cloudflare Workers AI ingyenes napi keretével.
# Railway Variables: Cloudflare Workers AI / Use REST API felületről.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
# Marketing Bejegyzések: csak jóváhagyott tervezet kézi publikálásához.
# A token Facebook Page Access Token legyen pages_manage_posts, pages_read_engagement és pages_show_list jogosultsággal.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v26.0
# Opcionális: a Facebook-oldalhoz kapcsolt professzionális Instagram-fiók számszerű azonosítója.
# Üresen a rendszer a FACEBOOK_PAGE_ID alapján kéri le. A tokenhez instagram_basic és
# instagram_content_publish Meta-jogosultság is kell.
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Opcionális: a Facebook-oldalhoz kapcsolt professzionális Instagram-fiók számszerű azonosítója.
# Üresen a rendszer a FACEBOOK_PAGE_ID alapján kéri le. A tokenhez instagram_basic és
# instagram_content_publish Meta-jogosultság is kell.
INSTAGRAM_BUSINESS_ACCOUNT_ID=
