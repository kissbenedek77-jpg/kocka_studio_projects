# A Google Cloud OAuth web client adatai. Az átirányítás: https://SAJAT-DOMAIN/auth/callback
BASE_URL=https://SAJAT-DOMAIN
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OWNER_EMAIL=
SESSION_SECRET=

# A nyilvános ügyfélűrlap (/form, /api/form) szerveroldali Google-hozzáférése.
# Előállítás: npm run token (lásd NODE_MIGRATION.md).
OWNER_REFRESH_TOKEN=

SHEET_ID=1BqQ0F4QjWJQfpCB3zSOibKCZ41xk6GzW7V3W6gdNp7I
SHEET_NAME=Adatok

# Elküldött levelek olvasása IMAP-on.
IMAP_HOST=mail.kockastudio.hu
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# Levelek küldése SMTP-n keresztül (alapértelmezésben az IMAP-adatok).
SMTP_HOST=mail.kockastudio.hu
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Gemini AI-kivonat. A dashboardon is megadható, ekkor a _ProjektBeállítások munkalapra kerül.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
